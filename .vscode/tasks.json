{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Smart Parking",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "make clean && make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Smart Parking",
            "type": "shell",
            "command": "./smart_parking",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run Parking Monitor",
            "type": "shell",
            "command": "./parking_monitor",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}